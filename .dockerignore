# Anything that doesn't contribute to the image. KEEP THIS LEAN AND
# UNTRACKED-ONLY. The Dockerfile's version stage does `COPY . /repo` and
# runs `git describe --tags --always --dirty` against the result; if we
# exclude any TRACKED file from the build context, git sees a deletion in
# the working tree relative to the index and the version banner gets a
# spurious `-dirty` suffix on every clean build.
#
# Image-size impact is also nil: the runtime stage explicitly copies only
# `app/` (`COPY app/ /app/`), so anything else in the context never lands
# in a layer regardless of whether it's listed here.

# Build artefacts and editor cruft (all untracked by .gitignore)
output/
__pycache__/
*.pyc
*.pyo
.coverage
coverage.xml
.pytest_cache/

.claude/
.idea/
.vscode/
.DS_Store
.venv/
node_modules/

# Local-override compose file is untracked; if a developer has one we
# don't want it shipped via the build context.
docker-compose.override.yml

# Secrets — never let a developer's .env land in a layer or in the
# context tar uploaded to a remote daemon.
.env
.env.*
!.env.example
