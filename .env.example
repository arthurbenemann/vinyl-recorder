# vinyl-recorder configuration. Copy this file to `.env` (next to
# docker-compose.yml) and uncomment any line you want to override. Compose
# picks `.env` up automatically; restart the container to apply.
# Every var falls back to a sensible default in app/state.py if unset.

# --- Stream source ---------------------------------------------------------

# Pre-fill the "Stream source" field. Any HTTP(S) audio stream URL works.
# If pointing at a pi-recorder host, the UI auto-detects the /info + /gain
# control endpoints and shows an analog-PGA gain slider.
# Default: https://ice1.somafm.com/groovesalad-256-mp3
#DEFAULT_STREAM_URL=http://pi-recorder:8000/stream

# When true, the UI connects to DEFAULT_STREAM_URL automatically on page
# load. Browsers block autoplay without user interaction — if blocked, the
# log shows the error and the user can press "connect" to grant the gesture.
# Default: false
#AUTO_CONNECT=true

# Initial ADC gain in dB applied on connect to a pi-recorder host (range
# -12 to +40, 0.5 dB step). Leave unset to keep whatever the Pi was last
# set to.
#DEFAULT_GAIN_DB=-6

# --- Recording -------------------------------------------------------------

# Pre-roll buffer: prepend the last N seconds of upstream audio to a new
# recording so the first groove is never missed. The ring lives in
# UpstreamSession; capacity is sample_rate × channels × bytes_per_sample × N.
# 0 disables.
# Default: 5
#PRE_ROLL_SECONDS=5

# Auto-stop on silence: when the upstream's smoothed RMS stays below
# SILENCE_THRESHOLD_DB for SILENCE_SECONDS continuous seconds, the
# recording finalizes itself (reason="auto", same FLAC-flush path the
# duration limit uses). The session must have seen at least one
# above-threshold chunk first — lead-in silence (cueing the needle,
# pre-roll, dead air before the first track) never triggers an
# auto-stop. The detector smooths the RMS over ~2 s so vinyl
# runout-groove clicks (~-29 dBFS peaks every revolution at 33⅓ RPM)
# can't keep re-arming it — the runout's mean energy is ~-47 dBFS RMS,
# cleanly below the -40 dBFS default and well above an absolute-silence
# track gap.
#
# Only the duration knob is exposed in the UI (the "Silence" dropdown
# next to "Time limit", with an ∞ option that disables the feature per
# recording). The detection threshold (SILENCE_THRESHOLD_DB) is an
# ops/calibration knob set via the env only — no per-recording UI for
# it, because the right value depends on the source pre-amp / ADC
# noise floor, not anything the user picks per side.
#
# Default: -40.0 / 10
#SILENCE_THRESHOLD_DB=-40
#SILENCE_SECONDS=10

# Armed auto-record: the ◉ auto-record toggle in the UI puts the server in
# standby — recording starts by itself on the first silence→signal
# transition (needle drop), with pre-roll covering the detection latency.
# The arm stays active across the recordings it starts (flip the record,
# drop the needle, side B records itself), and self-disarms after this
# many hours without keeping the Pi capturing forever. Arming is always an
# explicit user action; this only bounds how long it lingers.
# Default: 24
#ARM_AUTO_DISARM_HOURS=24

# --- Split-modal defaults --------------------------------------------------

# Wave-editor split defaults — applied each time the split modal is opened.
# Normalize on=true: peak-normalize every track using one gain value across
# the whole album, so relative loudness between sides is preserved.
# Default: true
#DEFAULT_SPLIT_NORMALIZE=true

# ReplayGain on=true: after a FLAC split, write ReplayGain track + album
# loudness tags (one metaflac pass over all tracks). Players normalise
# volume on playback; the audio is never modified (reversible). FLAC only —
# other output formats skip it. Non-destructive, so on by default.
# Default: true
#DEFAULT_SPLIT_REPLAYGAIN=true

# Target peak in dBFS used when normalize is on. -1.0 dB matches the
# default; lower = more headroom for inter-sample peaks. Not exposed in the UI.
# Default: -1.0
#DEFAULT_SPLIT_TARGET_PEAK_DB=-1.0

# Output bit depth for split tracks. 0 = keep source (24-bit from the Pi),
# 16 = downconvert to 16-bit (≈30% smaller files, plenty for vinyl),
# 24 = force 24-bit.
# Default: 0
#DEFAULT_SPLIT_BIT_DEPTH=0

# --- Discogs ---------------------------------------------------------------

# Discogs collection-aware tagging. When DISCOGS_USERNAME is set, the
# auto-tag candidate panel surfaces matches from your owned collection
# above the MusicBrainz results. DISCOGS_TOKEN is optional — it raises
# Discogs API rate limits and is required for private collections.
#DISCOGS_USERNAME=
#DISCOGS_TOKEN=

# --- Jellyfin --------------------------------------------------------------

# Trigger a Jellyfin library scan after every successful split, so the new
# album is playable immediately instead of waiting for Jellyfin's periodic
# scan. Both vars are required (the refresh endpoint needs authentication);
# create a key under Jellyfin Dashboard → Advanced → API Keys. Best-effort:
# a down/unreachable Jellyfin never fails the split — the outcome shows up
# as a line in the UI log either way.
#JELLYFIN_URL=http://jellyfin:8096
#JELLYFIN_API_KEY=

# --- Logging ---------------------------------------------------------------

# Root log level. Accepts any standard `logging` name
# (DEBUG | INFO | WARNING | ERROR | CRITICAL). Applied to the root logger
# at startup; uvicorn keeps its own handler.
# Default: INFO
#LOG_LEVEL=INFO

# Log output format. `json` emits one JSON object per line on stdout (ts,
# level, logger, msg, exc) so `docker compose logs | jq` works directly.
# Any other value (including the default) uses a plain human-readable
# format: `HH:MM:SS LEVEL   logger: message`.
# Default: text
#LOG_FORMAT=text

# --- Output paths ----------------------------------------------------------

# Relocate the Jellyfin-shaped output directory (e.g. to a network share).
# This is the path *inside the container* — also add a matching bind mount
# via docker-compose.override.yml, e.g.:
#   services:
#     vinyl-recorder:
#       volumes:
#         - /mnt/jellyfin/music:/mnt/jellyfin/music
# Default: /output/music (already mounted via the bind in docker-compose.yml)
#MUSIC_OUTPUT_DIR=/mnt/jellyfin/music
